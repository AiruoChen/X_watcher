{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true, "verbatimModuleSyntax": true,
    "declaration": true, "sourceMap": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
