# Demo is offline. Explicit source:* preview supports RSSHub / official X; live still fails.
APP_MODE=demo
WATCH_HANDLES=thsottiaux
POLL_INTERVAL_MINUTES=30
TIME_ZONE=Asia/Shanghai
DAILY_DIGEST_AT=08:00
# Set the real recipient only in your ignored .env file.
NOTIFICATION_TO=reader@example.invalid

# Configuration schema; parsing future modes does not enable them.
CONFIG_SCHEMA_VERSION=1
STORAGE_KIND=memory
DATABASE_PATH=data/x-watcher.sqlite
# Foreground simulated host: set STORAGE_KIND=sqlite, then npm run watch -- --create.
RUNTIME_WAKE_MS=1000
RUNTIME_LEASE_SECONDS=60
RUNTIME_SHUTDOWN_SECONDS=15
RUNTIME_MAX_CONCURRENT=8
RUNTIME_BATCH_SIZE=50
INITIAL_BACKFILL_DAYS=1
RESET_MAX_AGE_HOURS=24
DIGEST_CATCH_UP_DAYS=7
MAX_CATCH_UP_EMAILS=3
DIGEST_GRACE_MINUTES=15
FAILURE_THRESHOLD=3
STALE_AFTER_MINUTES=90
POST_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=1800
RETRY_JITTER=0.2
SOURCE_TIMEOUT_SECONDS=30
X_MAX_PAGES=20
X_PAGE_SIZE=100
X_REQUEST_TIMEOUT_SECONDS=10
X_SAFETY_LAG_SECONDS=30
X_OVERLAP_SECONDS=120
X_FIELD_DIALECT=post
# Self-hosted RSSHub (no X Bearer Token in this app):
RSSHUB_BASE_URL=http://127.0.0.1:1200
RSSHUB_ITEM_LIMIT=100
RSSHUB_REQUEST_TIMEOUT_SECONDS=20
RSSHUB_OVERLAP_HOURS=48
RSSHUB_SAFETY_LAG_SECONDS=30
ANALYSIS_TIMEOUT_SECONDS=120
MAIL_TIMEOUT_SECONDS=30
ANALYZER_VERSION=fixture-v1
PROMPT_VERSION=v1
# Future provider/model choices and credential ENVIRONMENT VARIABLE NAMES.
# Store actual credentials in the named environment variables, never in tracked files.
SOURCE_PROVIDER=
SOURCE_CREDENTIAL_ENV=
# RSSHub: APP_MODE=preview, STORAGE_KIND=sqlite, DATABASE_PATH=data/rsshub-preview.sqlite,
# SOURCE_PROVIDER=rsshub, SOURCE_CREDENTIAL_ENV= (empty), ANALYSIS_PROVIDER=deferred.
# See docs/integrations/rsshub.md and deploy/rsshub/.env.example for RSSHub cookies.
# B04 read-only setup (see docs/integrations/x.md): APP_MODE=preview,
# STORAGE_KIND=sqlite, DATABASE_PATH=data/x-preview.sqlite, SOURCE_PROVIDER=x-api-v2,
# SOURCE_CREDENTIAL_ENV=X_BEARER_TOKEN, ANALYSIS_PROVIDER=deferred.
# Put X_BEARER_TOKEN only in your ignored .env or process environment; do not commit it.
ANALYSIS_PROVIDER=
ANALYSIS_CREDENTIAL_ENV=
ANALYSIS_MODEL=
MAIL_PROVIDER=
MAIL_CREDENTIAL_ENV=
MAIL_FROM=
# Optional limits; empty means not configured. Enforcement arrives in B08.
MAX_CALLS_PER_DAY=
MAX_COST_PER_DAY=

# B05/B06 interfaces only: no provider is selected or enabled by these fields.
ANALYSIS_ALLOW_PARTIAL=false
MAIL_ACCOUNT=
MAIL_IDEMPOTENCY_TTL_SECONDS=0
MAIL_MAX_ATTEMPTS=5
